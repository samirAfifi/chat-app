rules_version = '2';

// Chat ids are "<uidA>_<uidB>" (sorted), so membership can be checked from the path
// without an extra document read.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /chats/{chatId} {
      function inChat() {
        return signedIn() && request.auth.uid in chatId.split('_');
      }

      allow get: if inChat();
      // The contact list queries `members array-contains <my uid>`.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if inChat()
        && request.resource.data.members.hasOnly(chatId.split('_'))
        && request.resource.data.members.size() == 2;
      allow delete: if false;

      match /messages/{messageId} {
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // Anyone in the chat may set/clear only their own reaction.
        function isOwnReaction() {
          return changed().hasOnly(['reactions'])
            && request.resource.data.reactions
                 .diff(resource.data.get('reactions', {}))
                 .affectedKeys().hasOnly([request.auth.uid]);
        }

        // The sender may edit the text or delete (blank out) their own message.
        function isOwnEditOrDelete() {
          return resource.data.senderId == request.auth.uid
            && changed().hasOnly(['text', 'editedAt', 'deleted', 'type', 'fileUrl',
                                  'fileName', 'fileSize', 'contentType', 'replyTo'])
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000;
        }

        allow read: if inChat();
        allow create: if inChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update: if inChat()
          && resource.data.get('deleted', false) != true
          && (isOwnReaction() || isOwnEditOrDelete());
        allow delete: if false;
      }
    }
  }
}
